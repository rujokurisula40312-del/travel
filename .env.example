# ====================================================================
# Travel Bot Pro — переменные окружения
# ====================================================================
# Скопируй этот файл в .env и заполни реальными значениями.
# Файл .env НЕ должен попадать в git — он уже в .gitignore.
# ====================================================================

# --- Google Sheets ---
# ID мастер-таблицы (реестр всех клиентов). Получишь по инструкции
# в docs/templates/google-sheets-setup.md
MASTER_CONFIG_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# JSON сервис-аккаунта Google Cloud (в одну строку или base64).
# Получишь по инструкции в docs/templates/google-sheets-setup.md
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# --- Anthropic (Claude) ---
# API-ключ, получишь на https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxx

# --- Окружение ---
ENV=dev
LOG_LEVEL=INFO
